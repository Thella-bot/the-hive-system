APP_NAME="HBCI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Application locale settings
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode driver (file or database)
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# PHP built-in server workers (uncomment for CLI server)
# PHP_CLI_SERVER_WORKERS=4

# Bcrypt rounds for password hashing (12 is recommended)
BCRYPT_ROUNDS=12

# Logging configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database configuration
# For local development with SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# For production with MySQL:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hbci
DB_USERNAME=root
DB_PASSWORD=

# Session configuration
# Options: database, redis, file, cookie
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting configuration
# Use 'reverb' for production WebSocket server
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue configuration
# Options: sync, database, redis, sqs
# Use 'redis' for production
QUEUE_CONNECTION=database

# Cache configuration
# Options: file, database, redis, memcached
# Use 'redis' for production
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached configuration (if using memcached)
MEMCACHED_HOST=127.0.0.1

# Redis configuration (required for Reverb, cache, and queues in production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail configuration
# Options: log, smtp, sendmail, mailgun, ses, postmark
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hbci.ac.ls"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 configuration (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite configuration
VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket) configuration
VITE_PUSHER_APP_KEY=dummy_key
VITE_PUSHER_APP_CLUSTER=mt1

# Sanctum stateful domains (for SPA authentication)
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173

# Sanctum token expiration (in minutes)
# SANCTUM_TOKEN_EXPIRATION=1440

# Reverb configuration (for production)
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
